<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5EF"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#526B58"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_total_debt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/widget_debt_default"
        android:textColor="#263A2E"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_monthly_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_room_default"
        android:textColor="#75847A"
        android:textSize="10sp" />

    <Button
        android:id="@+id/widget_add_payment"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="7dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/widget_add_payment"
        android:textAllCaps="false"
        android:textSize="10sp" />
</LinearLayout>
